# Public frontend origin allowed by the API gateway CORS config
CORS_ALLOWED_ORIGIN_PATTERNS=https://www.yourdomain.com

# Shared app secrets
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_SHARED_SECRET=replace-with-a-second-long-random-secret

# MongoDB connection strings
MONGODB_URI_IDENTITY=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/identity?retryWrites=true&w=majority
MONGODB_URI_PROFILE=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/profile?retryWrites=true&w=majority
MONGODB_URI_VERIFICATION=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/verification?retryWrites=true&w=majority
MONGODB_URI_LISTING=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/listing?retryWrites=true&w=majority
MONGODB_URI_NOTIFICATIONS=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/notifications?retryWrites=true&w=majority
MONGODB_URI_ORDER=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/order?retryWrites=true&w=majority
MONGODB_URI_ADMIN=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/admin?retryWrites=true&w=majority
MONGODB_URI_COMMUNITY=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/community?retryWrites=true&w=majority
MONGODB_URI_REVIEW=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/review?retryWrites=true&w=majority
MONGODB_URI_FOLLOW=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/follow?retryWrites=true&w=majority
MONGODB_URI_PAYMENT=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/payment?retryWrites=true&w=majority

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_RETURN_URL=https://api.yourdomain.com/api/stripe/onboarding/return
STRIPE_REFRESH_URL=https://api.yourdomain.com/api/stripe/onboarding/refresh
FRONTEND_PROFILE_URL=https://www.yourdomain.com/profile
PUBLIC_PLATFORM_BASE_URL=https://www.yourdomain.com
