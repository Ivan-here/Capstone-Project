FROM eclipse-temurin:21-jre

ARG SERVICE_DIR
ARG APP_PORT

WORKDIR /app
RUN groupadd --system app && useradd --system --gid app app
COPY --chown=app:app ${SERVICE_DIR}/build/libs/app.jar app.jar

USER app

EXPOSE ${APP_PORT}

ENV JAVA_OPTS="-Xms64m -Xmx160m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m"

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
